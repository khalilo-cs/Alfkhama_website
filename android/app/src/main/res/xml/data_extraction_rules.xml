<?xml version="1.0" encoding="utf-8"?>
<!-- ملف data_extraction_rules.xml: قواعد Android 12 فما فوق للنسخ الاحتياطي السحابي ونقل الجهاز. -->
<!-- يستثني كل المجالات (ملفات، قواعد بيانات، تفضيلات، تخزين خارجي) فلا تُنسخ جلسة المدير. -->
<!-- Nothing from the app (cookies, WebView storage, cache) is backed up or copied to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
