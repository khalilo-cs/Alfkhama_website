# انسخ هذا الملف إلى .env (وهو خارج Git) لتجهيز التشغيل المحلي.
# عند كل إقلاع: إن كانت ADMIN_PASSWORD مضبوطة وتغيّرت قيمتها (أو اسم المستخدم) منذ آخر تطبيق، يُحدَّث حساب المدير
# الموجود (ويُنهى كل الجلسات). إن بقيت القيم كما هي فلا تُستبدل كلمة مرور غيّرها المدير من لوحة الإدارة.
ADMIN_USERNAME=admin
# 12 خانة فأكثر. اتركها فارغة ليولّد الخادم كلمة مرور عشوائية عند إنشاء قاعدة جديدة. لا تضع كلمة المرور الحقيقية في Git.
ADMIN_PASSWORD=
# لتطبيقها يدويًا دون إعادة تشغيل الخادم: python3 app.py set-admin
# لمرحلة التصميم على هذا الجهاز فقط: يسمح بكلمة مرور من 6 خانات. يُرفض تلقائيًا إن كان الخادم متاحًا من خارج الجهاز.
# ALLOW_WEAK_PASSWORD=1

# --- الحفظ الدائم خارج الحاوية (مطلوب على خطة Render المجانية، لأن قرصها يُمسح عند كل إيقاف) ---
# كل الأربعة التالية يجب ضبطها معًا وإلا يبقى النسخ الخارجي معطّلًا. المخزن يجب أن يكون خاصًا (Private)
# والمفتاح مقيّدًا بتلك الحاوية فقط، لأن اللقطات تحوي بيانات العملاء وبصمة كلمة مرور المدير.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=alfakhama/
# ثوانٍ بين لقطتين عند تغيير مهم (الافتراضي 120). إحصاءات الزيارات وحدها تُحفظ كل 600 ثانية على الأقل (BACKUP_ANALYTICS_INTERVAL).
# BACKUP_INTERVAL=120
# قاعدة بيانات جديدة تبدأ "جاهزة" بلا شريط النسخة التجريبية (لا تغيّر قيمة حفظها المدير).
# SITE_READY_DEFAULT=1
