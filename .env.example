# انسخ هذا الملف إلى .env (وهو خارج Git) لتجهيز التشغيل المحلي.
# عند كل إقلاع: إن كانت ADMIN_PASSWORD مضبوطة وتغيّرت قيمتها (أو اسم المستخدم) منذ آخر تطبيق، يُحدَّث حساب المدير
# الموجود (ويُنهى كل الجلسات). إن بقيت القيم كما هي فلا تُستبدل كلمة مرور غيّرها المدير من لوحة الإدارة.
ADMIN_USERNAME=admin
# 12 خانة فأكثر. اتركها فارغة ليولّد الخادم كلمة مرور عشوائية عند إنشاء قاعدة جديدة. لا تضع كلمة المرور الحقيقية في Git.
ADMIN_PASSWORD=
# لتطبيقها يدويًا دون إعادة تشغيل الخادم: python3 app.py set-admin
# لمرحلة التصميم على هذا الجهاز فقط: يسمح بكلمة مرور من 6 خانات. يُرفض تلقائيًا إن كان الخادم متاحًا من خارج الجهاز.
# ALLOW_WEAK_PASSWORD=1
